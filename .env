# .env.example — copy to .env and fill in
# Generate SECRET_KEY: openssl rand -hex 32

# App
APP_ENV=development
SECRET_KEY=85bec04a91a7e198c38c49efc17c0dcb793de57c426f66ee698a9db58d85511a
ACCESS_TOKEN_EXPIRE_HOURS=8
ALGORITHM=HS256
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://thrift_user:thrift_pass@localhost:5432/thrift_store
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
IMAGE_STORAGE_PATH=/data/images
IMAGE_BASE_URL=http://localhost:8000/images

# CV
CV_MODEL=openai/clip-vit-base-patch32
CV_CONFIDENCE_THRESHOLD=0.4
CV_PROCESSING_TIMEOUT=5.0

# Printer
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_TIMEOUT=3.0
LABEL_WIDTH_MM=57
LABEL_HEIGHT_MM=32

# Internal
TEMP_IMAGE_TTL_SECONDS=600
PRINT_QUEUE_MAX_ATTEMPTS=5
BARCODE_PREFIX=THR
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ThriftOS
