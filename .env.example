# .env.example — copy to .env and fill in
# Generate SECRET_KEY: openssl rand -hex 32

# App
APP_ENV=development
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32_minimum_64_chars_required
ACCESS_TOKEN_EXPIRE_HOURS=8
ALGORITHM=HS256
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://thrift_user:thrift_pass@localhost:5432/thrift_store
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
IMAGE_STORAGE_PATH=/data/images
IMAGE_BASE_URL=http://localhost:8000/images

# CV — API-based (Phase A: quick intake, Phase B: deep analysis on sold items)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
CV_PHASE_A_MODEL=gpt-4o-mini
CV_PHASE_B_MODEL=gpt-4o
CV_FASHION_MODEL=patrickjohncyh/fashion-clip
CV_IMAGE_SIZE_PHASE_A=512
CV_IMAGE_SIZE_PHASE_B=768
CV_CONFIDENCE_THRESHOLD=0.4
CV_PROCESSING_TIMEOUT=30.0
CV_PHASE_B_TRIGGER_DAYS=7

# Motion detection (frontend, passed through public config endpoint)
CV_STILLNESS_THRESHOLD_MS=800
CV_MOTION_THRESHOLD_PCT=15

# Printer
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_TIMEOUT=3.0
LABEL_WIDTH_MM=57
LABEL_HEIGHT_MM=32

# Internal
TEMP_IMAGE_TTL_SECONDS=600
PRINT_QUEUE_MAX_ATTEMPTS=10
BARCODE_PREFIX=THR
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ThriftOS
